# Copy to .env and fill in locally. Never commit .env.
ENGINE=fake
MODEL=openai/gpt-oss-120b
GPU_MEMORY_UTILIZATION=0.85
DATA_DIR=./data
# Built frontend served from the same origin (e.g. ../frontend/dist). Empty: API only.
# FRONTEND_DIST=
# Where real mode gets its night: "db" is the latest finished run in the SQLite store at
# DB_PATH; "stored" is the 11 Oct night in fixtures/.
NIGHT_SOURCE=stored
# SQLite store of night runs (load the 11 Oct night: uv run python -m scripts.import_night).
DB_PATH=./telereason.sqlite
# auto: a small night reuses the latest stored gate; full: every night runs the gate.
GATE_MODE=auto
# Gate device: auto tries the GPU and falls back to the CPU; cuda or cpu force one.
GATE_DEVICE=auto
HF_TOKEN=
# Comma-separated browser origins for a separate frontend deployment.
CORS_ORIGINS=http://localhost:5173
# Requests per client per minute on POST /api/ask and POST /api/night-runs; 0 turns a limit off.
RATE_LIMIT_ASK_PER_MIN=10
RATE_LIMIT_NIGHT_PER_MIN=2
# 1 behind the Cloudflare tunnel: read the client from CF-Connecting-IP, else the last X-Forwarded-For value.
TRUST_PROXY_HEADERS=0
# Fake mode only: answer /api from a live real-mode backend while its /api/health says ready,
# and from fixtures/ otherwise (backend/telereason/api/remote.py, infra/droplet.md).
REMOTE_API_URL=
REMOTE_API_KEY=
# Real mode behind a public tunnel: every /api request must carry this key (the demo's REMOTE_API_KEY).
API_KEY=
