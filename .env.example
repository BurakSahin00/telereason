# Copy to .env and fill in locally. Never commit .env.
ENGINE=fake
MODEL=openai/gpt-oss-120b
GPU_MEMORY_UTILIZATION=0.85
DATA_DIR=./data
# Built frontend served from the same origin (e.g. ../frontend/dist). Empty: API only.
# FRONTEND_DIST=
# Where real mode gets its night: "stored" is the 11 Oct night in fixtures/ (only value for now).
NIGHT_SOURCE=stored
DB_PATH=./telereason.sqlite
HF_TOKEN=
CORS_ORIGINS=http://localhost:5173
