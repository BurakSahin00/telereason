# Copy to .env and fill in locally. Never commit .env.
ENGINE=fake
MODEL=openai/gpt-oss-120b
GPU_MEMORY_UTILIZATION=0.85
DATA_DIR=./data
# Built frontend served from the same origin (e.g. ../frontend/dist). Empty: API only.
# FRONTEND_DIST=
# Where real mode gets its night: "stored" is the 11 Oct night in fixtures/ (only value for now).
NIGHT_SOURCE=stored
DB_PATH=./telereason.sqlite
HF_TOKEN=
CORS_ORIGINS=http://localhost:5173
# Requests per client per minute on POST /api/ask and POST /api/night-runs; 0 turns a limit off.
RATE_LIMIT_ASK_PER_MIN=10
RATE_LIMIT_NIGHT_PER_MIN=2
# 1 behind the Cloudflare tunnel: read the client from CF-Connecting-IP, else the last X-Forwarded-For value.
TRUST_PROXY_HEADERS=0