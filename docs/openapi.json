    "/api/windows": {
      "get": {
        "summary": "List Windows",
        "operationId": "list_windows_api_windows_get",
        "parameters": [
          {
            "name": "line",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "FactoryWave",
                    "AURSAD"
