    "/api/ask": {
      "post": {
        "summary": "Ask",
        "operationId": "ask_api_ask_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AskRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "SSE stream; one schema item is one `event:` plus `data:` message.",
            "content": {
              "text/event-stream": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/ToolCallMessage"
                    },
                    {
                      "$ref": "#/components/schemas/ToolResultMessage"
                    },
                    {
                      "$ref": "#/components/schemas/AnswerMessage"
                    },
                    {
                      "$ref": "#/components/schemas/DoneMessage"
                    },
                    {
                      "$ref": "#/components/schemas/ErrorMessage"
                    }
                  ],
                  "title": "Response Ask Api Ask Post",
                  "discriminator": {
                    "propertyName": "event",
                    "mapping": {
                      "tool_call": "#/components/schemas/ToolCallMessage",
                      "tool_result": "#/components/schemas/ToolResultMessage",
                      "answer": "#/components/schemas/AnswerMessage",
                      "done": "#/components/schemas/DoneMessage",
                      "error": "#/components/schemas/ErrorMessage"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
